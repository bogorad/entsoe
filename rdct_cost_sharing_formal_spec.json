  "normativeContext": {
    "objective": "Standardize data exchange for inter-TSO redispatch and countertrade cost sharing while allowing CCR-specific methodology choices.",
    "principles": [
      "requesterPays",
      "ownerPays",
      "polluterPays",
      "socialization",
      "socializationCongestionIncomeBased",
      "fixedKey"
    ],
    "profiles": [
      {
        "id": "RAS",
