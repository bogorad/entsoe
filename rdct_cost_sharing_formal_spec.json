        "version": "2.1 in IG, 2.2 in profile spec",
        "family": "IEC 61970"
      },
      {
        "id": "ACK",
        "name": "Acknowledgement_MarketDocument",
        "version": "8.1",
        "family": "IEC 62325-451-1"
      },
