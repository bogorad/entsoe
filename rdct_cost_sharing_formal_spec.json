  "validationRules": [
    {
      "id": "VR-001",
      "severity": "error",
      "description": "Every RemedialActionSchedule must link to exactly one RemedialAction"
    },
    {
      "id": "VR-002",
      "severity": "error",
      "description": "RemedialActionSchedule must have ProposingEntity or at least one ProposingRemedialActionScheduleShare"
    },
    {
      "id": "VR-003",
      "severity": "error",
      "description": "When a costly remedial action is not activated, activatedVolumeMW and variableIncurredCostPerMWh must both be zero"
    },
    {
      "id": "VR-004",
      "severity": "error",
      "description": "Confirmation reason code must be A01 or A02"
    },
    {
      "id": "VR-005",
      "severity": "error",
      "description": "RASettlement process.processType must equal A66"
    },
    {
      "id": "VR-006",
      "severity": "error",
      "description": "RASettlement TimeSeries businessType must be C86 or C87"
    },
    {
      "id": "VR-007",
      "severity": "warning",
      "description": "Review-period timeout results in implicit positive confirmation"
    }
