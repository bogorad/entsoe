        "version": "1.0",
        "family": "IEC 62325-351 based custom profile"
      }
    ]
  },
  "roleModel": {
    "actors": [
      {
        "id": "SO",
        "name": "System Operator",
        "marketRoleCode": "A04",
        "responsibilities": [
          "Provide costs and activated volumes",
          "Validate settlement attachment",
          "Validate invoicing documents"
        ]
      },
      {
        "id": "CSC",
        "name": "Cost Sharing Calculator",
        "marketRoleCode": "A53",
        "responsibilities": [
          "Calculate cost sharing",
          "Issue settlement attachment",
          "Forward validated settlement attachment"
        ]
      },
      {
        "id": "RAC",
        "name": "Remedial Action Coordinator",
        "responsibilities": [
          "Provide grid model and activated costly remedial actions and overloaded elements"
        ],
        "inScope": false
      },
      {
        "id": "SR",
        "name": "Settlement Responsible",
        "marketRoleCode": "A54",
        "responsibilities": [
          "Perform financial settlement"
        ],
        "inScope": "partly"
      },
      {
        "id": "BA",
        "name": "Billing Agent",
        "responsibilities": [
          "Issue corresponding invoices"
        ],
        "inScope": false
      }
    ],
    "policyOptions": {
      "technicalPartPerformedByRCC": true,
      "financialPartPerformedByCSE": true,
      "note": "Both options depend on TSO request and CCR setup"
    }
  },
  "processModel": {
    "choreography": [
      {
        "step": 1,
        "name": "ProvideCostsAndActivatedVolumes",
        "from": "SO",
        "to": "CSC",
        "document": "RAS",
        "description": "SO sends provisional or final remedial action costs and activated volumes"
      },
      {
        "step": 2,
        "name": "CalculateCostSharing",
        "from": "CSC",
        "to": "CSC",
        "document": "internal",
        "description": "CSC validates inputs and computes settlement attachment"
      },
      {
        "step": 3,
        "name": "ProvideSettlementAttachment",
        "from": "CSC",
        "to": "SO",
        "document": "RASETTLEMENT",
        "description": "CSC sends settlement attachment for SO validation"
      },
      {
        "step": 4,
        "name": "ConfirmSettlementAttachment",
        "from": "SO",
        "to": "CSC",
        "document": "CONF",
        "description": "SO confirms or rejects settlement attachment"
      },
      {
        "step": 5,
        "name": "ForwardValidatedSettlementAttachment",
        "from": "CSC",
        "to": "SR",
        "document": "RASETTLEMENT",
        "description": "CSC forwards validated settlement attachment to settlement responsible"
      },
      {
        "step": 6,
        "name": "PerformFinancialSettlement",
        "from": "SR",
        "to": "SR",
        "document": "outOfScope",
        "description": "Financial settlement generates invoicing documents"
      },
      {
        "step": 7,
        "name": "IssueInvoices",
        "from": "BA",
        "to": "SO",
        "document": "outOfScope",
        "description": "Billing agent issues corresponding invoices"
      }
    ],
    "acknowledgementRule": {
      "description": "All received profiles except RAS are acknowledged in syntactic and business semantic way",
      "appliesTo": [
        "ACK",
        "CONF",
        "RASETTLEMENT"
      ],
      "excludes": [
        "RAS"
      ]
    },
    "timingPolicy": {
      "coreExample": {
        "upstreamInputAvailability": "D+1",
        "provisionalCorrectionDeadline": "30 days after month end",
        "finalCostDeadline": "90 days after quarter end"
      },
      "noConfirmationBehavior": "Settlement attachment is deemed positively confirmed after review period",
      "regionalOverrideAllowed": true
    },
    "reworkLoops": [
      {
        "condition": "Input invalid",
        "action": "Resubmit costs and activated volumes"
      },
      {
        "condition": "Negative confirmation",
        "action": "CSC recalculates and reissues settlement attachment"
      },
      {
        "condition": "Invoicing documents not correct",
        "action": "SR re-performs financial settlement"
      }
    ]
  },
